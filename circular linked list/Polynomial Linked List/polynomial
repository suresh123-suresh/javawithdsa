class PolyNode {
    int coeff, pow;
    PolyNode next;
    PolyNode(int c, int p) { coeff = c; pow = p; }
}

public class PolynomialLinkedList {
    PolyNode head;

    public void insert(int coeff, int pow) {
        PolyNode newNode = new PolyNode(coeff, pow);
        if (head == null) head = newNode;
        else {
            PolyNode temp = head;
            while (temp.next != null) temp = temp.next;
            temp.next = newNode;
        }
    }

    public void display() {
        PolyNode temp = head;
        while (temp != null) {
            System.out.print(temp.coeff + "x^" + temp.pow);
            if (temp.next != null) System.out.print(" + ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        PolynomialLinkedList poly = new PolynomialLinkedList();
        poly.insert(5, 2); // 5x^2
        poly.insert(3, 1); // 3x^1
        poly.insert(2, 0); // 2
        poly.display(); // Output: 5x^2 + 3x^1 + 2
    }
}
