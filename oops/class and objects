class Car {   // Class
    String color;
    int speed;

    void drive() {
        System.out.println("Car is driving at " + speed + " km/h");
    }
}

public class Main {
    public static void main(String[] args) {
        Car myCar = new Car();   // Object
        myCar.color = "Red";
        myCar.speed = 100;
        myCar.drive();
    }
}
