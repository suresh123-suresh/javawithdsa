public class Main {
    public static void main(String[] args) {
        String str = "racecar";
        
        String reversed = new StringBuilder(str).reverse().toString();
        
        if (str.equals(reversed)) {
            System.out.println(str + " is a palindrom.");
        } else {
            System.out.println(str + " is not a palindrom.");
        }
        
    }
}
