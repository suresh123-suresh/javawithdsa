import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        int evenCount = 0;
        int oddCount = 0;

        // Input array elements
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();

            if (arr[i] % 2 == 0) {
                evenCount++;
            } else {
                oddCount++;
            }
        }

        // Display the counts
        System.out.println("Even Count = " + evenCount);
        System.out.println("Odd Count = " + oddCount);

        sc.close();
    }
}
