public class Main {
    public static void main(String[] args) {
        String str = "Hello";
        
        String reversed1 = new StringBuilder(str).reverse().
toString();
        System.out.println("Reverse (StringBuildert): " + reversed1);
        
        String reversed2 = "";
        for (int i = str.length() - 1; i >= 0; i --) {
            reversed2 += str.charAt(i);
        }
        System.out.println("Reversed (loop): " + reversed2);
        
    }
}v
